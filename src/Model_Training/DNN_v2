import os
import json
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, TensorDataset, random_split
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import mean_squared_error, r2_score


# ----------------------------
# 1. Load processed data
# ----------------------------
def load_processed_data():
    with open("config.json", "r") as f:
        config = json.load(f)
    data_dir = config["data_dir"]

    data = torch.load(os.path.join(data_dir, "processed_data_0001_v3.pt"))
    X = data["X"]
    y = data["y"]
    return X, y


# ----------------------------
# 2. Define DNN architecture
# ----------------------------
class EnergyRegressor(nn.Module):
    def __init__(self, input_dim):
        super(EnergyRegressor, self).__init__()
        self.net = nn.Sequential(
            nn.Linear(input_dim, 256),
            nn.BatchNorm1d(256),
            nn.ReLU(),
            nn.Dropout(0.2),

            nn.Linear(256, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(),
            nn.Dropout(0.2),

            nn.Linear(128, 64),
            nn.ReLU(),

            nn.Linear(64, 1)
        )

    def forward(self, x):
        return self.net(x)


# ----------------------------
# 3. Custom metrics
# ----------------------------
def mean_relative_error(preds, labels):
    return torch.mean(torch.abs(preds - labels) / (labels + 1e-8))

def mean_absolute_relative_error(preds, labels):
    return torch.mean((preds - labels) / (labels + 1e-8))


# ----------------------------
# 4. Training function
# ----------------------------
def train_dnn(num_epochs=100, batch_size=512, lr=1e-3, train_ratio=0.8):

    # Load dataset
    X, y = load_processed_data()

    n_train = int(train_ratio * len(X))
    n_val = len(X) - n_train

    train_ds, val_ds = random_split(TensorDataset(X, y), [n_train, n_val])
    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)
    val_loader = DataLoader(val_ds, batch_size=batch_size)

    input_dim = X.shape[1]
    device = "cuda" if torch.cuda.is_available() else "cpu"

    model = EnergyRegressor(input_dim).to(device)
    criterion = nn.MSELoss()
    optimizer = optim.Adam(model.parameters(), lr=lr)

    train_losses, val_losses, rel_errors = [], [], []

    for epoch in range(num_epochs):
        model.train()
        epoch_loss = 0
        for xb, yb in train_loader:
            xb, yb = xb.to(device), yb.to(device)
            optimizer.zero_grad()
            preds = model(xb)
            loss = criterion(preds, yb)
            loss.backward()
            optimizer.step()
            epoch_loss += loss.item() * xb.size(0)

        train_loss = epoch_loss / len(train_loader.dataset)

        # Validation
        model.eval()
        val_loss = 0
        rel_err = 0
        with torch.no_grad():
            for xb, yb in val_loader:
                xb, yb = xb.to(device), yb.to(device)
                preds = model(xb)
                val_loss += criterion(preds, yb).item() * xb.size(0)
                rel_err += mean_relative_error(preds, yb).item() * xb.size(0)

        val_loss /= len(val_loader.dataset)
        rel_err /= len(val_loader.dataset)

        train_losses.append(train_loss)
        val_losses.append(val_loss)
        rel_errors.append(rel_err)

        print(f"Epoch [{epoch+1}/{num_epochs}] | Train Loss: {train_loss:.6f} | Val Loss: {val_loss:.6f} | Mean Rel Err: {rel_err:.6f}")

    # Final Evaluation
    model.eval()
    with torch.no_grad():
        X_val, y_val = val_ds[:]
        X_val, y_val = X_val.to(device), y_val.to(device)
        preds = model(X_val).cpu().numpy()
        y_val = y_val.cpu().numpy()

    mse = mean_squared_error(y_val, preds)
    r2 = r2_score(y_val, preds)
    rel_err = np.mean(np.abs(preds - y_val) / y_val)

    print("\n=== Final Evaluation ===")
    print(f"MSE: {mse:.6f}")
    print(f"R² Score: {r2:.6f}")
    print(f"Mean Relative Error: {rel_err:.6f}")

    # Save model
    torch.save(model.state_dict(), "dnn_energy_model.pth")
    print("Model saved as dnn_energy_model.pth")

    # ----------------------------
    # 5. Plot Training Curves
    # ----------------------------
    plt.figure(figsize=(8, 5))
    plt.plot(train_losses, label="Train Loss")
    plt.plot(val_losses, label="Validation Loss")
    plt.xlabel("Epoch")
    plt.ylabel("MSE Loss")
    plt.title("Training and Validation Loss per Epoch")
    plt.legend()
    plt.grid(True)
    plt.show()

    plt.figure(figsize=(8, 5))
    plt.plot(rel_errors, label="Mean Relative Error")
    plt.xlabel("Epoch")
    plt.ylabel("Relative Error")
    plt.title("Relative Error over Epochs")
    plt.legend()
    plt.grid(True)
    plt.show()

    plt.figure(figsize=(7, 5))
    plt.hist((preds - y_val) / y_val, bins=50, alpha=0.7)
    plt.xlabel("(Predicted - True) / True")
    plt.ylabel("Frequency")
    plt.title("Relative Error Distribution")
    plt.grid(True)
    plt.show()

    # ----------------------------
    # 6. Feature Importance (Weight Magnitude)
    # ----------------------------
    weights = model.net[0].weight.detach().cpu().numpy()
    importance = np.mean(np.abs(weights), axis=0)

    plt.figure(figsize=(8, 5))
    plt.bar(range(len(importance)), importance)
    plt.title("Approximate Feature Importance (Mean |Weights| of Input Layer)")
    plt.xlabel("Feature Index (Layer Number)")
    plt.ylabel("Importance (|w|)")
    plt.grid(True)
    plt.show()

    # ----------------------------
    # 7. Permutation Importance (optional, slower)
    # ----------------------------
    print("Calculating permutation-based feature importance (this may take a while)...")
    baseline_mse = mean_squared_error(y_val, preds)
    perm_importance = np.zeros_like(importance)

    X_val_np = X_val.cpu().numpy().copy()

    for i in range(X_val_np.shape[1]):
        X_perm = X_val_np.copy()
        np.random.shuffle(X_perm[:, i])
        with torch.no_grad():
            perm_preds = model(torch.tensor(X_perm, dtype=torch.float32, device=device)).cpu().numpy()
        perm_mse = mean_squared_error(y_val, perm_preds)
        perm_importance[i] = perm_mse - baseline_mse

    plt.figure(figsize=(8, 5))
    plt.bar(range(len(perm_importance)), perm_importance)
    plt.title("Permutation Feature Importance (ΔMSE per Feature)")
    plt.xlabel("Feature Index (Layer Number)")
    plt.ylabel("ΔMSE (higher = more important)")
    plt.grid(True)
    plt.show()

    return model


# ----------------------------
# 8. Run
# ----------------------------
if __name__ == "__main__":
    train_dnn(num_epochs=100, batch_size=512, lr=1e-3)
